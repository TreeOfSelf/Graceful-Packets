{
	"schemaVersion": 1,
	"id": "graceful-packets",
	"version": "${version}",
	"name": "Graceful Packets",
	"description": "Prevents the client from crashing on packet decode errors. Optionally logs errors to chat.",
	"authors": [
		"TreeOfSelf"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/graceful-packets/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
          "me.treeofself.gracefulpackets.GracefulPackets"
		],
		"modmenu": [
          "me.treeofself.gracefulpackets.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"graceful-packets.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "~1.21.9",
		"java": ">=21",
		"fabric-api": "*"
	}
}